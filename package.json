{
  "name": "fix-it-london",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@fixitlondon/web",
    "build:web": "npm run build --workspace=@fixitlondon/web",
    "dev:mobile": "npm run start --workspace=@fixitlondon/mobile",
    "build:ios": "npm run build:ios --workspace=@fixitlondon/mobile",
    "build:android": "npm run build:android --workspace=@fixitlondon/mobile"
  }
}
